    <string name="st_cat_aa">הצגה ב-Android Auto</string>
    <string name="st_aa_status">סטטוס מקור ההתקנה</string>
    <string name="st_aa_status_ok">מוכן ל-Android Auto ✓\nמקור התקנה: Play (com.android.vending)\nיוזם: %1$s</string>
    <string name="st_aa_status_bad">לא יופיע ב-Android Auto ✗\nמתקין: %1$s\nיוזם: %2$s\nמקור: %3$s\n\nAndroid Auto מציג אפליקציות של Car App Library רק כשהמתקין הוא Play (com.android.vending) והיוזם הוא מתקין חבילות או Play. התקנה רגילה מ-APK (או מ-adb) לא מספיקה.</string>
    <string name="st_aa_reinstall">התקן מחדש כ-Play (Shizuku)</string>
    <string name="st_aa_reinstall_sum">פותח את מתקין החבילות כאילו הגיע מ-Play. אותה חתימה → עדכון, בלי הסרה. דורש Shizuku פעיל.</string>
    <string name="st_aa_adb">העתק פקודת adb (גיבוי)</string>
    <string name="st_aa_adb_sum">אם אין Shizuku: הדבק את הפקודה במחשב המחובר ב-USB. אחרי אישור ההתקנה, חזור לכאן ובדוק את הסטטוס.</string>
    <string name="st_aa_adb_copied">הפקודה הועתקה ללוח</string>
    <string name="st_aa_set_installer">נסיון ניסיוני: set-installer</string>
    <string name="st_aa_set_installer_sum">מריץ cmd package set-installer דרך Shizuku. ברוב המכשירים זה נדחה בלי root.</string>
    <string name="st_aa_warning">שים לב</string>
    <string name="st_aa_warning_sum">כל עדכון APK רגיל (התקנה מחדש מקובץ) מאפס את הרישום כ-Play, ואז צריך להריץ שוב את \"התקן מחדש כ-Play\". העדכון דרך הכפתור עצמו שומר על הרישום.</string>
    <string name="st_aa_shizuku_missing_title">צריך את Shizuku</string>
    <string name="st_aa_shizuku_missing_body">Shizuku (או Shizuku-Next) נותן לאפליקציה להריץ פעולות כמשתמש shell, בלי root.\n\n1. התקן את Shizuku-Next מהגיטהאב:\nhttps://github.com/rushiranpise/Shizuku-Next/releases\n\n2. הפעל אותו ב-Wireless debugging (או ב-USB):\nהגדרות → אפשרויות למפתחים → ניפוי באגים אלחוטי → הפעל → ב-Shizuku לחץ \"הפעלה באמצעות שידור אלחוטי\".\n\n3. חזור לכאן ואשר את ההרשאה כשמתבקש.</string>
    <string name="st_aa_shizuku_open">פתח את Shizuku</string>
    <string name="st_aa_shizuku_download">הורד Shizuku-Next</string>
    <string name="st_aa_shizuku_need_perm">אשר הרשאה ל-Shizuku</string>
    <string name="st_aa_shizuku_need_perm_body">לחץ \"אשר\" בדיאלוג של Shizuku, ואז חזור והקש שוב על הכפתור.</string>
