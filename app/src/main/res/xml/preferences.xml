    <Preference
        app:key="hdr_about"
        app:title="@string/st_hdr_about"
        app:summary="@string/st_hdr_about_sum"
        app:fragment="com.example.voicedialauto.SettingsActivity$AboutFragment"
        app:iconSpaceReserved="false" />
</PreferenceScreen>
