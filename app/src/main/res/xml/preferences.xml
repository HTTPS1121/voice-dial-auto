<?xml version="1.0" encoding="utf-8"?>
<!-- Root: one-line headers that open sub-screens. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
