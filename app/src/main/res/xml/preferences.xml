        app:fragment="com.example.voicedialauto.SettingsActivity$SpeechFragment"
        app:iconSpaceReserved="false" />
    <Preference
        app:key="hdr_timing"
        app:title="@string/st_hdr_timing"
        app:summary="@string/st_hdr_timing_sum"
        app:fragment="com.example.voicedialauto.SettingsActivity$TimingFragment"
        app:iconSpaceReserved="false" />
    <Preference
        app:key="hdr_dial"
        app:title="@string/st_hdr_dial"
        app:summary="@string/st_hdr_dial_sum"
